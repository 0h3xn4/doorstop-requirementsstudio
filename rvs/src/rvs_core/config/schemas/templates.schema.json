{"$schema": "http://json-schema.org/draft-07/schema#", "type": "object", "additionalProperties": false, "required": ["rvs_schema_version", "kinds"], "definitions": {"attr": {"type": "object", "additionalProperties": false, "required": ["name", "type"], "properties": {"name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}, "type": {"enum": ["string", "text", "enum", "int", "date", "uid-list", "string-list", "ref-list"]}, "vocab": {"type": "string"}, "required": {"type": "boolean"}, "help": {"type": "string"}}}, "kind": {"type": "object", "additionalProperties": false, "required": ["attributes", "fingerprint"], "properties": {"defaults": {"type": "object"}, "fingerprint": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "attributes": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/attr"}}}}}, "properties": {"rvs_schema_version": {"type": "integer", "minimum": 0}, "kinds": {"type": "object", "additionalProperties": false, "required": ["requirements", "verification"], "properties": {"requirements": {"$ref": "#/definitions/kind"}, "verification": {"$ref": "#/definitions/kind"}}}}}